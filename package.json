{
  "name": "sui-deeptrade-contract",
  "version": "2.0.0",
  "description": "A trading protocol on Sui that abstracts DeepBook's DEEP fees, featuring a tiered discount system and its own on-chain governance",
  "main": "index.js",
  "directories": {
    "example": "examples"
  },
  "scripts": {
    "prettier:ts": "prettier --write ./examples/**/*.ts",
    "prettier:move": "prettier --write ./packages/**/*.move",
    "lint": "tsc --noEmit",
    "test:multisig": "ts-node examples/multisig/test-multisig-tx.ts"
  },
  "author": "avernikoz@gmail.com",
  "license": "ISC",
  "dependencies": {
    "@mysten/sui": "2.26.0"
  },
  "devDependencies": {
    "@mysten/prettier-plugin-move": "0.3.1",
    "@types/node": "24.1.0",
    "dotenv": "17.4.2",
    "prettier": "3.9.6",
    "tsx": "4.22.4",
    "typescript": "5.7.3"
  }
}
